XRAY_VERSION=26.3.27
IMAGE_TAG=latest
LOCAL_BUILD=false

# SOCKS5 listener and authentication. Use a strong, unique password.
SOCKS_PORT=12345
SOCKS_USERNAME=change-me
SOCKS_PASSWORD=change-me-to-a-strong-password
SOCKS_LISTEN=0.0.0.0
SOCKS_UDP=true
SOCKS_UDP_ADVERTISE_IP=

# "auto" uses the interface carrying the default IPv6 route.
IPV6_INTERFACE=auto

# Leave blank to derive a stable /120 pool from the interface prefix.
IPV6_POOL=
IPV6_POOL_PREFIX_LEN=120
IPV6_POOL_SEED=random-ipv6-socks

# Pools broader than /120 can put pressure on the upstream NDP cache.
ALLOW_LARGE_IPV6_POOL=false
XRAY_LOG_LEVEL=warning
